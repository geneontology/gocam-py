{% extends "base.html.jinja2" %}

{% block title %}GO-CAM-like Models Report — {{ report.group.label }}{% endblock %}

{% block body %}
  <p><a href="index.html">&larr; All groups</a></p>
  <h1>GO-CAM-like Models Report — {{ report.group.label }}</h1>
  <p class="metadata">
    Generated by GO Central - {{ generated_at }}.
  </p>
  <ul class="summary">
    <li>
      <strong>{{ report.models | length | pluralize("model") }}</strong>
    </li>
    <li><strong>{{ report.success_models | length }}</strong> success</li>
    <li><strong>{{ report.filtered_models | length }}</strong> filtered</li>
    <li><strong>{{ report.error_models | length }}</strong> error</li>
  </ul>
  <table id="models-table" class="hover stripe">
    <thead>
    <tr>
      <th>Model ID</th>
      <th>Title</th>
      <th>Date modified</th>
      <th>Contributors</th>
      <th>Pipeline result</th>
      <th>Result details</th>
      <th>Warnings</th>
    </tr>
    </thead>
    <tbody>
    {% for model in report.models %}
      <tr>
        <td>
          <pre>{{ model.model_id }}</pre>
        </td>
        <td>{{ model.title or "" }}</td>
        <td>{{ model.date_modified or "" }}</td>
        <td>{{ model.contributor_names | join(", ") }}</td>
        <td class="status {{ model.pipeline_status }}">{{ model.pipeline_status }}</td>
        <td>{{ model.pipeline_status_details or "" }}</td>
        <td>
          {% if model.warnings %}
            <details class="warning-details">
              <summary>
                {{ model.warnings | length | pluralize("warning") }}
              </summary>
              <ul>
                {% for warning in model.warnings %}
                  <li>
                    {{ warning | warning_text }}
                  </li>
                {% endfor %}
              </ul>
            </details>
          {% endif %}
        </td>
      </tr>
    {% endfor %}
    </tbody>
  </table>
  <script>
    const showText = 'Show all warnings';
    const hideText = 'Hide all warnings';
    let toggleWarningsButton = document.createElement('button');
    toggleWarningsButton.textContent = showText;
    toggleWarningsButton.addEventListener('click', function () {
      const detailsElements = document.querySelectorAll('.warning-details');
      const isAnyOpen = Array.from(detailsElements).some(el => el.open);
      detailsElements.forEach(el => el.open = !isAnyOpen);
      this.textContent = isAnyOpen ? showText : hideText;
    });

    document.addEventListener('DOMContentLoaded', function () {
      new DataTable("#models-table", {
        columnDefs: [
          {targets: 2, type: 'string'}
        ],
        layout: {
          topEnd: ['search', toggleWarningsButton],
        },
        mark: true,
        order: [],
        paging: false,
      });
    });
  </script>
{% endblock %}
