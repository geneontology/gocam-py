{% extends "base.html.jinja2" %}

{% block title %}GO-CAM-like Models Report{% endblock %}

{% block body %}
  <h1>GO-CAM-like Models Report</h1>
  <p>
    These reports summarize the results of the GO-CAM processing pipeline. They report
    models which are considered at least "GO-CAM-like." This means that they:
  </p>
  <ul>
    <li>have status "production"</li>
    <li>have at least two causally connected activity units</li>
    <li>do not use complement types</li>
  </ul>
  <p>
    These models may still not meet the current "True GO-CAM" definition, in which case
    they will have a pipeline result of "filtered" and a result detail explaining what
    criteria was not met.
  </p>
  <p>
    Regardless of whether a model meets the "True GO-CAM" definition, it may contain
    relationships that are not supported by the current GO-CAM model specification.
    These are reported as warnings.
  </p>
  <p>
    The reports are organized by contributing group. Models associated with contributors
    from multiple groups appear in each applicable report. Because of this, the same
    model may appear in multiple reports and the total number of models across all
    reports may exceed the total number of unique models.
  </p>
  <p class="metadata">
    Generated by GO Central - {{ generated_at }}.
  </p>
  {% if reports %}
    <table id="groups-table" class="hover stripe">
      <thead>
      <tr>
        <th>Group</th>
        <th>Models</th>
        <th>Success</th>
        <th>Filtered</th>
        <th>Error</th>
      </tr>
      </thead>
      <tbody>
      {% for report in reports %}
        <tr>
          <td><a href="{{ report.filename }}">{{ report.group.label }}</a></td>
          <td>{{ report.models | length }}</td>
          <td>{{ report.success_models | length }}</td>
          <td>{{ report.filtered_models | length }}</td>
          <td>{{ report.error_models | length }}</td>
        </tr>
      {% endfor %}
      </tbody>
    </table>
  {% else %}
    <p>No matching models were found in the pipeline reports.</p>
  {% endif %}

  <script>
    document.addEventListener('DOMContentLoaded', function () {
      new DataTable("#groups-table", {
        order: [],
        paging: false,
        searching: false,
      });
    });
  </script>
{% endblock %}
