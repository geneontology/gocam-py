{% extends "base.html.jinja2" %}

{% block title %}GO-CAM pipeline result reports{% endblock %}

{% block body %}
  <h1>GO-CAM pipeline result reports</h1>
  <p>Production-model results organized by contributing group. Models associated with
    multiple groups appear in each applicable report. Because of this, the same model
    may appear in multiple reports and the total number of models across all reports may
    exceed the total number of unique models.</p>
  <p class="metadata">
    Generated by GO Central - {{ generated_at }}.
  </p>
  {% if reports %}
    <table>
      <thead>
      <tr>
        <th>Group</th>
        <th>Production models</th>
        <th>Success</th>
        <th>Filtered</th>
        <th>Error</th>
      </tr>
      </thead>
      <tbody>
      {% for report in reports %}
        <tr>
          <td><a href="{{ report.filename }}">{{ report.group.label }}</a></td>
          <td>{{ report.models | length }}</td>
          <td>{{ report.success_models | length }}</td>
          <td>{{ report.filtered_models | length }}</td>
          <td>{{ report.error_models | length }}</td>
        </tr>
      {% endfor %}
      </tbody>
    </table>
  {% else %}
    <p>No production models were found in the pipeline reports.</p>
  {% endif %}
{% endblock %}
